# ==============================================================================
# SmartApps Platform - Mẫu cấu hình biến môi trường (KHÔNG chứa secret thật)
# Sao chép các biến cần thiết vào môi trường local (.env hoặc PowerShell/Bash)
# ==============================================================================

# --- PostgreSQL (Docker Compose & Local) ---
POSTGRES_PASSWORD=change_me_local_postgres_password

# --- Backend (.NET 9 - Port 5200) ---
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=smartapps_db;Username=postgres;Password=change_me_local_postgres_password
# Lưu ý: Đặt chuỗi ngẫu nhiên đủ dài cho môi trường thật; không dùng lại secret mặc định của Docker Compose
Auth__Secret=change_me_random_secret_at_least_32_chars_long
ASPNETCORE_ENVIRONMENT=Development

# --- Frontend (Next.js 16 - Port 4100) ---
NEXT_PUBLIC_API_ORIGIN=http://localhost:5200

# --- Kiểm thử Integration & E2E (tùy chọn) ---
# Dùng database riêng cho test, KHÔNG trỏ vào database phát triển hoặc production
SMARTAPPS_TEST_POSTGRES=Host=127.0.0.1;Port=5432;Database=smartapps_test;Username=postgres;Password=change_me_local_postgres_password;Pooling=false
SMARTAPPS_E2E_POSTGRES=postgresql://postgres:change_me_local_postgres_password@127.0.0.1:5432/postgres
